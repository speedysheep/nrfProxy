build*/
HANDOVER.md

# Host-side unit test binaries
tests/host/*.exe
tests/host/*.o

# Twister output (unit/integration test runs). The -unit/-integration suffixes
# are what scripts/test_docker.sh writes, keeping the two suites' reports apart.
twister-out/
twister-out.*/
twister-out-*/

# Python bytecode from the stdlib test suites in scripts/
__pycache__/
*.pyc
